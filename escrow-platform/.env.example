DATABASE_URL="postgresql://user:password@localhost:5432/escrow_db?schema=public"

NODE_ENV=development
PORT=3001

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

FRONTEND_URL=http://localhost:3000

PLATFORM_WALLET_EMAIL=platform@escrow.com

MIDTRANS_SERVER_KEY=SB-Midtrans-Server-Key-Change-In-Production
MIDTRANS_CLIENT_KEY=SB-Midtrans-Client-Key-Change-In-Production
MIDTRANS_IS_PRODUCTION=false

XENDIT_SECRET_KEY=xnd_secret_key_change_in_production
XENDIT_IS_PRODUCTION=false

DOKU_MERCHANT_ID=your-doku-merchant-id
DOKU_SECRET_KEY=your-doku-secret-key
DOKU_IS_PRODUCTION=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@escrow-platform.com

LOG_LEVEL=info

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
